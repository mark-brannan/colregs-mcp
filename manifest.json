{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/mcpb-manifest.schema.json",
  "manifest_version": "0.3",
  "name": "colregs-mcp",
  "version": "0.0.2",
  "description": "Not for navigation. MCP server that answers questions under the COLREGS in a form a language model cannot quietly simplify: every lawful answer, every entry with its cite and the verbatim rule text. A preview on pre-release rule data; coverage is partial and the tool surface will change.",
  "author": {
    "name": "mark-brannan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/colregs-mcp.git"
  },
  "homepage": "https://github.com/mark-brannan/colregs-mcp#readme",
  "license": "Apache-2.0",
  "privacy_policies": [
    "https://github.com/mark-brannan/colregs-mcp#privacy-policy"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/cli.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/cli.js"
      ]
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=20"
    }
  }
}
